# courier — environment template (no secrets committed)
# These are endpoints/names only. The function key and ACS access use
# managed identity / Azure-issued values, not stored here.

# ACS resource endpoint (set as a Function app setting at deploy)
ACS_ENDPOINT=https://courier-acs.communication.azure.com

# Verified sender address (Azure-managed domain MailFrom)
SENDER_ADDRESS=donotreply@<guid>.azurecomm.net

# Comma-separated allowlist of recipient emails or domains (open-relay guard)
ALLOWED_RECIPIENTS=your-inbox@example.com

# User-assigned managed identity client id (set automatically by Bicep)
AZURE_CLIENT_ID=
